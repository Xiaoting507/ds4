        {
          "name": "6. GET - Cálculos recientes (LIBRE)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/calculos/recientes?dias=7",
              "host": ["{{base_url}}"],
              "path": ["api", "calculos", "recientes"],
              "query": [
                {
                  "key": "dias",
                  "value": "7",
                  "description": "Número de días hacia atrás"
                }
              ]
            },
            "description": "ENDPOINT LIBRE: Obtiene cálculos de los últimos N días"
          },
          "response": []
        }
      ]
