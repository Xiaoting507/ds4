@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Estadísticas por Idol";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-controller="Reportes" asp-action="Index">Reportes</a></li>
            <li class="breadcrumb-item active">Por Idol</li>
        </ol>
    </nav>

    <div class="mb-4">
        <h2>
            <i class="bi bi-star me-2" style="color: #fbbf24;"></i>
            Estadísticas por Idol
        </h2>
        <p class="text-muted">Actividad y popularidad de cada idol/grupo</p>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header" style="background: linear-gradient(135deg, #9333ea 0%, #ec4899 100%); color: white;">
                            <h5 class="mb-0">
                                <i class="bi bi-star-fill me-2"></i>
                                @item.Idol.NombreArtistico
                            </h5>
                            <small>@item.Idol.TipoIdol - @item.Idol.Fandom</small>
                        </div>
                        <div class="card-body">
                            <div class="row text-center mb-3">
                                <div class="col-6">
                                    <div class="border-end">
                                        <h3 style="color: #3b82f6;">@item.TotalEventos</h3>
                                        <small class="text-muted">Total Eventos</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <h3 style="color: #10b981;">@item.EventosRealizados</h3>
                                    <small class="text-muted">Realizados</small>
                                </div>
                            </div>

                            <hr/>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted">
                                        <i class="bi bi-people me-1"></i>Fans
                                    </span>
                                    <span class="badge" style="background-color: #ec4899;">@item.TotalFans</span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted">
                                        <i class="bi bi-ticket-perforated me-1"></i>Reservas
                                    </span>
                                    <span class="badge" style="background-color: #8b5cf6;">@item.TotalReservas</span>
                                </div>
                            </div>

                            @if (item.ProximoEvento != null)
                            {
                                <div class="alert alert-info mb-0">
                                    <small>
                                        <strong>Próximo Evento:</strong><br/>
                                        @item.ProximoEvento.Titulo<br/>
                                        <i class="bi bi-calendar me-1"></i>
                                        @item.ProximoEvento.FechaEvento.ToString("dd/MM/yyyy")
                                    </small>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-secondary mb-0">
                                    <small>
                                        <i class="bi bi-info-circle me-1"></i>
                                        Sin eventos programados
                                    </small>
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-light">
                            <a asp-controller="Idols" asp-action="Details" asp-route-id="@item.Idol.IdolId" 
                               class="btn btn-sm btn-outline-primary w-100">
                                <i class="bi bi-eye me-1"></i>Ver Detalles
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-info-circle" style="font-size: 3rem; color: #3b82f6;"></i>
            <h4 class="mt-3">No hay idols activos</h4>
            <p>Las estadísticas de idols aparecerán aquí.</p>
        </div>
    }

    <div class="mt-4">
        <a asp-action="Dashboard" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-2"></i>Volver al Dashboard
        </a>
    </div>
</div>
