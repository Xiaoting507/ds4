@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Estadísticas por Zona";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-controller="Reportes" asp-action="Index">Reportes</a></li>
            <li class="breadcrumb-item active">Por Zona</li>
        </ol>
    </nav>

    <div class="mb-4">
        <h2>
            <i class="bi bi-geo-alt me-2" style="color: #3b82f6;"></i>
            Estadísticas por Zona Geográfica
        </h2>
        <p class="text-muted">Distribución y actividad de eventos por zona</p>
    </div>

    @if (Model.Any())
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead style="background-color: #f8f9fa;">
                            <tr>
                                <th>Zona</th>
                                <th class="text-center">Total Eventos</th>
                                <th class="text-center">Realizados</th>
                                <th class="text-center">Próximos</th>
                                <th class="text-center">Total Reservas</th>
                                <th class="text-center">Capacidad Total</th>
                                <th>Último Evento</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>
                                            <i class="bi bi-geo-alt-fill me-1" style="color: #3b82f6;"></i>
                                            @item.Zona
                                        </strong>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge" style="background-color: #8b5cf6;">@item.TotalEventos</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success">@item.EventosRealizados</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info">@item.EventosProximos</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary">@item.TotalReservas</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">@item.CapacidadTotal</span>
                                    </td>
                                    <td>
                                        @if (item.UltimoEvento != null)
                                        {
                                            <small>
                                                <strong>@item.UltimoEvento.Titulo</strong><br/>
                                                <i class="bi bi-calendar me-1"></i>
                                                @item.UltimoEvento.FechaEvento.ToString("dd/MM/yyyy")
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">Sin eventos</small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Gráfico de Distribución -->
        <div class="row">
            @foreach (var item in Model.Take(6))
            {
                var totalEventos = (int)item.TotalEventos;
                var maxEventos = Model.Max(z => (int)z.TotalEventos);
                var porcentaje = maxEventos > 0 ? (totalEventos * 100.0 / maxEventos) : 0;
                
                <div class="col-md-4 col-lg-2 mb-3">
                    <div class="card text-center shadow-sm h-100">
                        <div class="card-body">
                            <i class="bi bi-geo-alt-fill fs-2 mb-2" style="color: #3b82f6;"></i>
                            <h6 class="mb-2">@item.Zona</h6>
                            <h3 style="color: #8b5cf6;">@totalEventos</h3>
                            <small class="text-muted">Eventos</small>
                            <div class="progress mt-2" style="height: 5px;">
                                <div class="progress-bar" role="progressbar" 
                                     style="width: @porcentaje.ToString("F0")%; background-color: #8b5cf6;" 
                                     aria-valuenow="@porcentaje" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-info-circle" style="font-size: 3rem; color: #3b82f6;"></i>
            <h4 class="mt-3">No hay eventos registrados</h4>
            <p>Las estadísticas por zona aparecerán aquí.</p>
        </div>
    }

    <div class="mt-3">
        <a asp-action="Dashboard" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-2"></i>Volver al Dashboard
        </a>
    </div>
</div>
