@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Eventos Más Populares";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-controller="Reportes" asp-action="Index">Reportes</a></li>
            <li class="breadcrumb-item active">Eventos Populares</li>
        </ol>
    </nav>

    <div class="mb-4">
        <h2>
            <i class="bi bi-trophy me-2" style="color: #fbbf24;"></i>
            Eventos Más Populares
        </h2>
        <p class="text-muted">Top 20 eventos con más asistencia y reservas</p>
    </div>

    @if (Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead style="background-color: #f8f9fa;">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Evento</th>
                                <th>Idol</th>
                                <th>Fecha</th>
                                <th class="text-center">Reservas</th>
                                <th class="text-center">Total Personas</th>
                                <th class="text-center">% Ocupación</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int ranking = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">
                                        @if (ranking <= 3)
                                        {
                                            <span class="badge" style="background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);">
                                                @ranking
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@ranking</span>
                                        }
                                    </td>
                                    <td>
                                        <strong>@item.Evento.Titulo</strong><br/>
                                        <small class="text-muted">@item.Evento.TipoEvento</small>
                                    </td>
                                    <td>
                                        @if (item.Evento.Idol != null)
                                        {
                                            <i class="bi bi-star-fill me-1" style="color: #fbbf24;"></i>
                                            <span>@item.Evento.Idol.NombreArtistico</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin idol</span>
                                        }
                                    </td>
                                    <td>
                                        <small>@item.Evento.FechaEvento.ToString("dd/MM/yyyy")</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary">@item.TotalReservas</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge" style="background-color: #8b5cf6;">
                                            <i class="bi bi-people me-1"></i>@item.TotalPersonas
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @{
                                            var ocupacion = (double)item.PorcentajeOcupacion;
                                            var colorClase = ocupacion >= 90 ? "danger" : (ocupacion >= 70 ? "warning" : "success");
                                        }
                                        <span class="badge bg-@colorClase">@ocupacion.ToString("F1")%</span>
                                    </td>
                                    <td>
                                        @switch (item.Estado)
                                        {
                                            case "Programado":
                                                <span class="badge bg-info">Programado</span>
                                                break;
                                            case "EnCurso":
                                                <span class="badge bg-warning">En Curso</span>
                                                break;
                                            case "Finalizado":
                                                <span class="badge bg-secondary">Finalizado</span>
                                                break;
                                            case "Cancelado":
                                                <span class="badge bg-danger">Cancelado</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                                ranking++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-info-circle" style="font-size: 3rem; color: #3b82f6;"></i>
            <h4 class="mt-3">No hay eventos registrados</h4>
            <p>Los eventos más populares aparecerán aquí.</p>
        </div>
    }

    <div class="mt-3">
        <a asp-action="Dashboard" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-2"></i>Volver al Dashboard
        </a>
    </div>
</div>
