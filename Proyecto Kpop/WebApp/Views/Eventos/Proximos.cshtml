@model IEnumerable<Evento>

@{
    ViewData["Title"] = "Próximos Eventos";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1><i class="bi bi-calendar-event"></i> Próximos Eventos</h1>
        <p class="lead">Reserva tu puesto en los próximos eventos del fanclub</p>
    </div>
    <div class="col-md-4 text-end">
        @if (Context.Session.GetInt32("UsuarioId").HasValue)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Crear Evento
            </a>
        }
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-4">
        @foreach (var evento in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 event-card">
                    @if (!string.IsNullOrEmpty(evento.ImagenURL))
                    {
                        <img src="@evento.ImagenURL" class="card-img-top" alt="@evento.Titulo" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-gradient" style="height: 200px; background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);"></div>
                    }
                    
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                @if (!string.IsNullOrEmpty(evento.TipoEvento))
                                {
                                    <span class="badge bg-secondary mb-2">@evento.TipoEvento</span>
                                }
                            </div>
                            <div>
                                @if (evento.PuestosDisponibles > 0)
                                {
                                    <span class="badge bg-success">
                                        @evento.PuestosDisponibles disponibles
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">LLENO</span>
                                }
                            </div>
                        </div>

                        <h5 class="card-title">@evento.Titulo</h5>
                        
                        @if (evento.Idol != null)
                        {
                            <p class="mb-1">
                                <i class="bi bi-star-fill text-warning"></i>
                                <strong>@evento.Idol.NombreArtistico</strong>
                                @if (!string.IsNullOrEmpty(evento.Idol.Fandom))
                                {
                                    <span class="text-muted">(@evento.Idol.Fandom)</span>
                                }
                            </p>
                        }

                        <p class="mb-1">
                            <i class="bi bi-calendar3"></i>
                            <strong>@evento.FechaEvento.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))</strong>
                        </p>

                        <p class="mb-1">
                            <i class="bi bi-clock"></i>
                            @string.Format("{0:hh\\:mm}", evento.HoraInicio)
                            @if (evento.HoraFin.HasValue)
                            {
                                <text> - @evento.HoraFin.Value.ToString(@"hh\:mm")</text>
                            }
                        </p>

                        <p class="mb-2">
                            <i class="bi bi-geo-alt-fill text-danger"></i>
                            <strong>@evento.Zona</strong>
                        </p>

                        <p class="text-muted small mb-3">
                            <i class="bi bi-map"></i> @evento.Direccion
                        </p>

                        @if (!string.IsNullOrEmpty(evento.Descripcion) && evento.Descripcion.Length > 100)
                        {
                            <p class="card-text text-muted small">
                                @evento.Descripcion.Substring(0, 100)...
                            </p>
                        }
                        else if (!string.IsNullOrEmpty(evento.Descripcion))
                        {
                            <p class="card-text text-muted small">@evento.Descripcion</p>
                        }

                        <div class="progress mb-3" style="height: 8px;">
                            <div class="progress-bar" role="progressbar" 
                                 style="width: @evento.PorcentajeOcupacion%"
                                 aria-valuenow="@evento.PorcentajeOcupacion" aria-valuemin="0" aria-valuemax="100">
                            </div>
                        </div>

                        <p class="mb-3 small text-muted">
                            <i class="bi bi-people"></i>
                            @evento.PuestosOcupados / @evento.Capacidad personas
                            (@evento.PorcentajeOcupacion.ToString("F0")% ocupado)
                        </p>
                    </div>

                    <div class="card-footer bg-white border-top-0">
                        <div class="d-grid gap-2">
                            @if (evento.PuestosDisponibles > 0)
                            {
                                <a asp-action="Reservar" asp-route-id="@evento.EventoId" class="btn btn-primary">
                                    <i class="bi bi-ticket-perforated"></i> Reservar Ahora
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary" disabled>
                                    <i class="bi bi-x-circle"></i> Sin Puestos
                                </button>
                            }
                            <a asp-action="Details" asp-route-id="@evento.EventoId" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-info-circle"></i> Ver Detalles
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="bi bi-calendar-x" style="font-size: 4rem; color: var(--secondary-color);"></i>
                    <h3 class="mt-3">No hay eventos próximos</h3>
                    <p class="text-muted">No se han programado eventos para las próximas fechas.</p>
                    @if (Context.Session.GetInt32("UsuarioId").HasValue)
                    {
                        <a asp-action="Create" class="btn btn-primary mt-3">
                            <i class="bi bi-plus-circle"></i> Crear Primer Evento
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
}
