@model IEnumerable<SistemaFanclub.Models.Evento>

@{
    ViewData["Title"] = "Gestión de Eventos";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active">Eventos</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>
                <i class="bi bi-calendar-event me-2" style="color: #9333ea;"></i>
                Gestión de Eventos
            </h2>
            <p class="text-muted mb-0">@Model.Count() eventos en total</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg" 
           style="background: linear-gradient(135deg, #9333ea 0%, #ec4899 100%); border: none;">
            <i class="bi bi-plus-circle me-2"></i>Crear Evento
        </a>
    </div>

    <!-- Filtros de Búsqueda -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Buscar</label>
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" 
                           class="form-control" placeholder="Buscar por título..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Zona</label>
                    <select name="zona" class="form-select">
                        <option value="">Todas las zonas</option>
                        <option value="Ciudad de Panamá">Ciudad de Panamá</option>
                        <option value="Panamá Norte">Panamá Norte</option>
                        <option value="Panamá Oeste">Panamá Oeste</option>
                        <option value="Panamá Este">Panamá Este</option>
                        <option value="Chiriquí">Chiriquí</option>
                        <option value="Otro">Otro</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Fecha</label>
                    <input type="date" name="fecha" class="form-control" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-2"></i>Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Navegación de Tabs -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link active" href="#todos" data-bs-toggle="tab">
                <i class="bi bi-list-ul me-2"></i>Todos los Eventos
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#proximos" data-bs-toggle="tab">
                <i class="bi bi-calendar-check me-2"></i>Próximos
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#pasados" data-bs-toggle="tab">
                <i class="bi bi-calendar-x me-2"></i>Pasados
            </a>
        </li>
    </ul>

    <!-- Contenido de Tabs -->
    <div class="tab-content">
        <!-- Tab: Todos los Eventos -->
        <div class="tab-pane fade show active" id="todos">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead style="background-color: #f8f9fa;">
                            <tr>
                                <th>Fecha</th>
                                <th>Evento</th>
                                <th>Idol</th>
                                <th>Zona</th>
                                <th>Capacidad</th>
                                <th>Disponibles</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var evento in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@evento.FechaEvento.ToString("dd/MM/yyyy")</strong><br/>
                                        <small class="text-muted">
                                            @string.Format("{0:hh\\:mm}", evento.HoraInicio) - @string.Format("{0:hh\\:mm}", evento.HoraFin)
                                        </small>
                                    </td>
                                    <td>
                                        <strong>@evento.Titulo</strong><br/>
                                        <span class="badge bg-secondary">@evento.TipoEvento</span>
                                    </td>
                                    <td>
                                        @if (evento.Idol != null)
                                        {
                                            <i class="bi bi-star-fill me-1" style="color: #fbbf24;"></i>
                                            @evento.Idol.NombreArtistico
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin idol</span>
                                        }
                                    </td>
                                    <td>
                                        <i class="bi bi-geo-alt me-1"></i>
                                        @evento.Zona
                                    </td>
                                    <td class="text-center">
                                        @evento.Capacidad
                                    </td>
                                    <td class="text-center">
                                        @if (evento.PuestosDisponibles > 0)
                                        {
                                            <span class="badge bg-success">@evento.PuestosDisponibles</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">LLENO</span>
                                        }
                                    </td>
                                    <td>
                                        @switch (evento.Estado)
                                        {
                                            case "Programado":
                                                <span class="badge bg-info">Programado</span>
                                                break;
                                            case "EnCurso":
                                                <span class="badge bg-warning">En Curso</span>
                                                break;
                                            case "Finalizado":
                                                <span class="badge bg-secondary">Finalizado</span>
                                                break;
                                            case "Cancelado":
                                                <span class="badge bg-danger">Cancelado</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@evento.EventoId" 
                                               class="btn btn-outline-info" title="Ver Detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@evento.EventoId" 
                                               class="btn btn-outline-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@evento.EventoId" 
                                               class="btn btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    No hay eventos registrados. <a asp-action="Create" class="alert-link">Crear el primer evento</a>
                </div>
            }
        </div>

        <!-- Tab: Próximos -->
        <div class="tab-pane fade" id="proximos">
            @{
                var proximosEventos = Model.Where(e => e.FechaEvento >= DateTime.Today && e.Estado == "Programado");
            }
            @if (proximosEventos.Any())
            {
                <div class="row g-3">
                    @foreach (var evento in proximosEventos)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h5 class="card-title">@evento.Titulo</h5>
                                    <p class="card-text">
                                        <i class="bi bi-calendar me-2"></i>@evento.FechaEvento.ToString("dd/MM/yyyy")<br/>
                                        <i class="bi bi-clock me-2"></i>@string.Format("{0:hh\\:mm}", evento.HoraInicio) - @string.Format("{0:hh\\:mm}", evento.HoraFin)<br/>
                                        <i class="bi bi-geo-alt me-2"></i>@evento.Zona
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="badge bg-primary">@evento.PuestosDisponibles puestos</span>
                                        <a asp-action="Details" asp-route-id="@evento.EventoId" class="btn btn-sm btn-outline-primary">
                                            Ver Detalles
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    No hay eventos próximos programados.
                </div>
            }
        </div>

        <!-- Tab: Pasados -->
        <div class="tab-pane fade" id="pasados">
            @{
                var eventoPasados = Model.Where(e => e.FechaEvento < DateTime.Today || e.Estado == "Finalizado");
            }
            @if (eventoPasados.Any())
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Evento</th>
                                <th>Asistencia</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var evento in eventoPasados)
                            {
                                <tr>
                                    <td>@evento.FechaEvento.ToString("dd/MM/yyyy")</td>
                                    <td>@evento.Titulo</td>
                                    <td>@evento.PuestosOcupados / @evento.Capacidad personas</td>
                                    <td><span class="badge bg-secondary">@evento.Estado</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    No hay eventos pasados.
                </div>
            }
        </div>
    </div>
</div>
