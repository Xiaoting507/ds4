@model IEnumerable<SistemaFanclub.Models.Reserva>

@{
    ViewData["Title"] = "Gestión de Reservas";
}

<div class="container-fluid mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active">Reservas</li>
        </ol>
    </nav>

    <div class="row mb-4">
        <div class="col-md-8">
            <h2>
                <i class="bi bi-calendar-check me-2"></i>
                Gestión de Reservas
            </h2>
            <p class="text-muted">@Model.Count() reservas registradas</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-controller="Eventos" asp-action="Proximos" class="btn btn-primary" 
               style="background: linear-gradient(135deg, #9333ea 0%, #ec4899 100%); border: none;">
                <i class="bi bi-plus-circle me-2"></i>
                Nueva Reserva
            </a>
        </div>
    </div>

    <!-- Estadísticas Rápidas -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm" style="border-left: 4px solid #10b981;">
                <div class="card-body">
                    <h3 class="mb-0" style="color: #10b981;">@Model.Count(r => r.Confirmada && !r.EstaCancelada)</h3>
                    <small class="text-muted">Confirmadas</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm" style="border-left: 4px solid #f59e0b;">
                <div class="card-body">
                    <h3 class="mb-0" style="color: #f59e0b;">@Model.Count(r => !r.Confirmada && !r.EstaCancelada)</h3>
                    <small class="text-muted">Pendientes</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm" style="border-left: 4px solid #ef4444;">
                <div class="card-body">
                    <h3 class="mb-0" style="color: #ef4444;">@Model.Count(r => r.EstaCancelada)</h3>
                    <small class="text-muted">Canceladas</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm" style="border-left: 4px solid #8b5cf6;">
                <div class="card-body">
                    <h3 class="mb-0" style="color: #8b5cf6;">@Model.Sum(r => r.NumeroPersonas)</h3>
                    <small class="text-muted">Total Personas</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros de Búsqueda -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Buscar</label>
                        <input type="text" name="busqueda" class="form-control" 
                               placeholder="Buscar por nombre, email o teléfono..." 
                               value="@ViewData["busqueda"]" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Estado</label>
                        <select name="estado" class="form-select">
                            <option value="">Todos los estados</option>
                            <option value="Confirmada">Confirmadas</option>
                            <option value="Pendiente">Pendientes</option>
                            <option value="Cancelada">Canceladas</option>
                            <option value="Asistio">Asistió</option>
                            <option value="NoAsistio">No Asistió</option>
                        </select>
                    </div>

                    <div class="col-md-2 mb-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100" 
                                style="background: linear-gradient(135deg, #9333ea 0%, #ec4899 100%); border: none;">
                            <i class="bi bi-search me-2"></i>Buscar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Reservas -->
    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead style="background-color: #f8f9fa;">
                            <tr>
                                <th>Evento</th>
                                <th>Nombre</th>
                                <th>Contacto</th>
                                <th>Personas</th>
                                <th>Estado</th>
                                <th>Fecha Reserva</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reserva in Model.OrderByDescending(r => r.FechaReserva))
                            {
                                <tr>
                                    <td>
                                        @if (reserva.Evento != null)
                                        {
                                            <div>
                                                <strong>@reserva.Evento.Titulo</strong><br/>
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar me-1"></i>
                                                    @reserva.Evento.FechaEvento.ToString("dd/MM/yyyy")
                                                </small>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin evento</span>
                                        }
                                    </td>
                                    <td>
                                        <div>
                                            <strong>@reserva.NombreReserva</strong>
                                            @if (reserva.Miembro != null)
                                            {
                                                <br/>
                                                <small class="text-muted">
                                                    <i class="bi bi-person-badge me-1"></i>
                                                    @reserva.Miembro.Nombre @reserva.Miembro.Apellido
                                                </small>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <i class="bi bi-envelope me-1"></i>@reserva.EmailContacto
                                            @if (!string.IsNullOrEmpty(reserva.TelefonoContacto))
                                            {
                                                <br/>
                                                <i class="bi bi-telephone me-1"></i>@reserva.TelefonoContacto
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge" style="background-color: #8b5cf6; font-size: 1rem;">
                                            <i class="bi bi-people me-1"></i>@reserva.NumeroPersonas
                                        </span>
                                    </td>
                                    <td>
                                        @switch (reserva.EstadoReserva)
                                        {
                                            case "Confirmada":
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>Confirmada
                                                </span>
                                                break;
                                            case "Pendiente":
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-clock me-1"></i>Pendiente
                                                </span>
                                                break;
                                            case "Cancelada":
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-x-circle me-1"></i>Cancelada
                                                </span>
                                                break;
                                            case "Asistió":
                                                <span class="badge bg-primary">
                                                    <i class="bi bi-check-all me-1"></i>Asistió
                                                </span>
                                                break;
                                            case "No Asistió":
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-x me-1"></i>No Asistió
                                                </span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @reserva.FechaReserva.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                        @if (reserva.EstaCancelada)
                                        {
                                            <br/>
                                            <small class="text-danger">
                                                <i class="bi bi-x-circle me-1"></i>
                                                Cancelada: @reserva.FechaCancelacion?.ToString("dd/MM/yyyy")
                                            </small>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@reserva.ReservaId" 
                                               class="btn btn-sm btn-outline-info" title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (!reserva.EstaCancelada)
                                            {
                                                <a asp-action="Edit" asp-route-id="@reserva.ReservaId" 
                                                   class="btn btn-sm btn-outline-warning" title="Editar">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <form asp-action="Cancelar" asp-route-id="@reserva.ReservaId" 
                                                      method="post" class="d-inline"
                                                      onsubmit="return confirm('¿Está seguro de cancelar esta reserva?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancelar">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" disabled title="Cancelada">
                                                    <i class="bi bi-ban"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center py-5">
                    <i class="bi bi-info-circle" style="font-size: 3rem; color: #3b82f6;"></i>
                    <h4 class="mt-3">No hay reservas registradas</h4>
                    <p class="mb-3">Comienza reservando puestos para eventos.</p>
                    <a asp-controller="Eventos" asp-action="Proximos" class="btn btn-primary"
                       style="background: linear-gradient(135deg, #9333ea 0%, #ec4899 100%); border: none;">
                        <i class="bi bi-plus-circle me-2"></i>Ver Eventos Disponibles
                    </a>
                </div>
            }
        </div>
    </div>
</div>
